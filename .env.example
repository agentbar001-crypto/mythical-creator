# Server-side Anthropic key used for the free tier. Never commit a real key.
ANTHROPIC_API_KEY=
# Free AI generations per visitor per day on the server key (0 disables the free tier).
FREE_GENERATIONS_PER_DAY=5
# Public site URL, used for canonical links and the sitemap (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://example.com
# Contact email shown on the privacy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=
# Site-wide cap on free generations per day across all visitors (0 = no cap). Protects your API bill.
FREE_GENERATIONS_GLOBAL_PER_DAY=500
# Shared counter store. Add Upstash Redis from the Vercel Marketplace and these are set for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Random string used to hash visitor IPs for the free-tier counter.
RATE_LIMIT_SALT=
