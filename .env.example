# Server-side Anthropic key used for the free tier. Never commit a real key.
ANTHROPIC_API_KEY=
# Free AI generations per visitor per day on the server key (0 disables the free tier).
FREE_GENERATIONS_PER_DAY=5
# Public site URL, used for canonical links and the sitemap (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://example.com
# Contact email shown on the privacy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=
